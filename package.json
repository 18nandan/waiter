{
  "name": "waiter",
  "version": "0.1.0",
  "description": "Waiter — a self-hosted, open-source AI memory API with hybrid BM25 and vector retrieval",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "bench:report": "tsx bench/report.ts && node bench/meeting-brief.mjs"
  },
  "keywords": [
    "memory",
    "api",
    "self-hosted",
    "longmemeval",
    "hybrid-search"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/pdfkit": "^0.17.7",
    "@types/uuid": "^10.0.0",
    "@xenova/transformers": "^2.17.2",
    "pdf-to-img": "^7.0.1",
    "pdfkit": "^0.20.2",
    "tsx": "^4.15.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
